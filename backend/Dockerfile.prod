# 운영 이미지 (uvicorn, reload 없음, 비root 실행)

# --- 빌드 단계: 런타임 의존성만 /opt/venv 에 설치 ---
FROM ghcr.io/astral-sh/uv:0.12.23-python3.14-trixie-slim AS build

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY . .
# 호스트에서 생긴 __pycache__ 가 실행 단계로 넘어가지 않게 제거(.dockerignore 는 개발 이미지와 공유하므로 건드리지 않음)
RUN uv sync --frozen --no-dev \
    && find /app/app -name __pycache__ -type d -prune -exec rm -rf {} +

# --- 실행 단계: 빌드 단계와 같은 Python(/usr/local/bin/python3.14) 경로를 쓰는 slim 이미지 ---
FROM python:3.14.8-slim-trixie

# 이름 있는 볼륨은 첫 마운트 시 이미지 디렉터리의 소유권을 이어받으므로 /srv/published 를 미리 app 소유로 만든다.
# uid·gid 10001 은 frontend/Dockerfile.prod 의 /srv/published 소유권과 맞춰 둔다.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /srv/published \
    && chown app:app /srv/published

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 테스트·캐시는 제외하고 venv 와 앱 소스만 복사한다.
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app/app ./app

USER app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=3)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
