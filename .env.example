# Plotline 환경변수 예시. 복사해서 .env로 쓰고 값은 환경별로 채운다.
# 시크릿 값은 이 파일에 쓰지 않는다. 키를 추가하면 각 환경 .env에도 같은 키를 넣는다(scripts/env-check.* 로 점검).

# 앱 환경 구분: local | production
APP_ENV=local

# DB 접속 정보 (로컬은 compose의 db 서비스, 운영은 공유 MariaDB)
DB_HOST=db
DB_PORT=3306
DB_NAME=plotline
DB_USER=plotline
# DB 사용자 비밀번호 (시크릿)
DB_PASSWORD=
# MariaDB root 비밀번호 — 로컬 db 컨테이너 초기화에만 사용 (시크릿)
DB_ROOT_PASSWORD=

# 관리자 단일 계정 (D-06, D-20)
ADMIN_USERNAME=
# 관리자 비밀번호 argon2id 해시 (평문 금지, 시크릿). 생성: docker compose exec backend uv run python -m app.admin_auth.hash_password
# 비어 있으면 관리자 로그인이 비활성(503)된다. 해시의 $ 가 compose 변수로 치환되지 않도록 반드시 작은따옴표로 감싼다: ADMIN_PASSWORD_HASH='$argon2id$...'
# 교체 후 api 컨테이너 재생성(설정 캐시) — 비밀번호 교체 시 기존 세션도 무효
ADMIN_PASSWORD_HASH=
# 세션 쿠키 서명 키 (시크릿, 32바이트 이상 무작위 값). 비었거나 짧으면 관리자 로그인 비활성. 교체하면 모든 세션 무효화
# 교체 후 api 컨테이너 재생성(설정 캐시) — 비밀번호 교체 시 기존 세션도 무효
SESSION_SECRET=
# 세션 쿠키 Secure 속성. 운영(https)은 true, 로컬 http 개발(127.0.0.1:5173)에서만 false
SESSION_COOKIE_SECURE=true
# 관리자 API 상태 변경 요청(POST·PUT·PATCH·DELETE)에 허용할 Origin, 쉼표 구분. scheme+host(+port) 그대로, 끝 / 없이 (예: https://plotline.duckdns.org)
ADMIN_ALLOWED_ORIGINS=

# 운영 compose 이미지 태그. 비우면 latest, 롤백 시 sha-<7자> 지정
WEB_IMAGE_TAG=
API_IMAGE_TAG=
