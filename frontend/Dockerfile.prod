# 운영 이미지 (nginx: 정적 파일 · /data 발행 볼륨 서빙 · /api 프록시)

# --- 빌드 단계: adapter-static 산출물(build/) 생성 ---
FROM node:24.21.0-alpine AS build

RUN npm install -g pnpm@12.10.1

WORKDIR /app

COPY package.json pnpm-lock.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# --- 실행 단계 ---
FROM nginx:1.30.5-alpine

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# 발행 볼륨(published) 마운트 지점. 빈 볼륨은 먼저 마운트한 컨테이너의 디렉터리 소유권을 이어받으므로
# api 이미지(backend/Dockerfile.prod)의 app 유저 uid·gid 10001 과 맞춘다. 한쪽을 바꾸면 다른 쪽도 바꾼다.
RUN mkdir -p /srv/published && chown 10001:10001 /srv/published

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1
